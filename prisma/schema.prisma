generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Auth: optional app login. When enabled, most routes require a valid session.
model AuthConfig {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

/// Global parental-control policy shared by every account and client.
model ParentalControlSettings {
  id           Int      @id @default(1)
  enabled      Boolean  @default(false)
  patternsJson String   @default("[]")
  /// bcrypt hash of the optional PIN used to unlock restricted channels.
  pinHash      String?
  updatedAt    DateTime @updatedAt
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id               String         @id @default(cuid())
  username         String         @unique
  passwordHash     String
  role             UserRole       @default(USER)
  isDisabled       Boolean        @default(false)
  /// The original administrator created at bootstrap — cannot be deleted; password/username can be reset via API or server script.
  isBootstrapAdmin Boolean        @default(false)
  lastLoginAt      DateTime?
  lastActivityAt   DateTime?
  lastLoginIp      String?
  lastLoginLocation String?
  lastLoginDevice  String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  refreshTokens    RefreshToken[]
  proxyConfigs     ProxyConfig[]
  favorites        UserFavorite[]
  viewingHistory   UserViewingHistory[]
  iptvCredentials IptvClientCredential[]
}

/// Long-lived portal login for Xtream-compatible IPTV apps (e.g. TiviMate): `portalUsername` + secret map to Xtream username/password.
model IptvClientCredential {
  id             String   @id @default(cuid())
  label          String   @default("")
  portalUsername String   @unique
  passwordHash   String
  /// When app auth is enabled, the signed-in user who created this credential. Null when auth is off (single-household mode).
  ownerUserId    String?
  owner          User?    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastUsedAt     DateTime?

  @@index([ownerUserId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Registered stream URLs (synced from clients). Used for nightly/on-demand probes.
model ChannelRegistryEntry {
  urlHash   String   @id
  url       String
  label     String?
  presetId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  probes          HealthProbe[]
  aggregate       HealthAggregate?
  proxyAssignment ChannelProxyAssignment?
}

model HealthProbe {
  id         String   @id @default(cuid())
  urlHash    String
  channel    ChannelRegistryEntry @relation(fields: [urlHash], references: [urlHash], onDelete: Cascade)
  checkedAt  DateTime @default(now())
  ok         Boolean
  latencyMs  Int?
  httpStatus Int?
  error      String?

  @@index([urlHash, checkedAt])
}

model HealthAggregate {
  urlHash     String   @id
  channel     ChannelRegistryEntry @relation(fields: [urlHash], references: [urlHash], onDelete: Cascade)
  tier        String
  successRate Float
  sampleCount Int
  windowDays  Int      @default(7)
  updatedAt   DateTime @updatedAt
}

/// Ephemeral HLS proxy session: maps opaque `id` → upstream URL + rewrite aliases (survives dev HMR).
model StreamProxySession {
  id              String   @id
  upstreamRootUrl String
  title           String
  logo            String?
  groupTitle      String?
  /// JSON object: short hash → absolute upstream URL (for overlong `?u=`).
  urlAliasesJson  String   @default("{}")
  /// JSON: hash → upstream playlist URL that referenced this resource — used as `Referer` for that hash (avoids racing `lastRefererUrl`).
  aliasReferersJson String @default("{}")
  /// JSON: `{ origin: { cookieName: cookieValue } }` — forwarded on segment requests (many CDNs require playlist cookies).
  cookieJarJson   String   @default("{}")
  /// Last upstream playlist URL fetched through this session — segments should use this `Referer` (not only the master URL).
  lastRefererUrl  String?
  /// Serialized StoredProxyConfig — proxy is read once at session creation; the proxy route never needs a second DB query.
  proxyConfigJson String?
  /// JSON: duration, series/episode context for VOD seek bar and next/prev controls.
  metaJson        String   @default("{}")
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
}

model ProxyConfig {
  id        String   @id @default(cuid())
  name      String
  /// "direct" | "gluetun"
  vpnType   String   @default("direct")
  protocol  String   @default("http")
  host      String   @default("")
  port      Int      @default(0)
  username  String?
  password  String?
  /// "nordvpn" | "expressvpn" | "protonvpn" | "custom_openvpn" | "custom_wireguard"
  vpnProvider    String?
  /// JSON blob with provider-specific credentials / config
  vpnConfigJson  String?
  /// Docker container ID for the running Gluetun container
  gluetunContainerId String?
  /// Host port mapped to Gluetun's internal HTTP proxy (8888)
  gluetunHostPort    Int?
  /// "stopped" | "starting" | "running" | "error"
  gluetunStatus      String   @default("stopped")
  /// User who created this proxy — null when auth is disabled or row was created before this field was added.
  createdByUserId    String?
  createdBy          User?    @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ChannelProxyAssignment[]
}

model ChannelProxyAssignment {
  urlHash   String      @id
  proxyId   String
  proxy     ProxyConfig          @relation(fields: [proxyId], references: [id], onDelete: Cascade)
  channel   ChannelRegistryEntry @relation(fields: [urlHash], references: [urlHash], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([proxyId])
}

/// Per-user (or global when auth is off) favorites list.
/// userId = "__guest__" when auth is disabled (single-user mode).
model UserFavorite {
  id         String   @id @default(cuid())
  userId     String
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  url        String
  name       String
  /// XMLTV / iptv-org channel id from playlist (tvg-id) — persisted for EPG and server-side cache warm.
  tvgId      String?
  tvgLogo    String?
  groupTitle String?
  addedAt    DateTime @default(now())

  @@unique([userId, url])
  @@index([userId, addedAt])
}

/// Per-user playback history — recency + play counts.
/// userId = "__guest__" when auth is disabled (single-user mode).
model UserViewingHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  url          String
  name         String
  tvgLogo      String?
  groupTitle   String?
  /// Serialized PlaybackSessionMeta for VOD resume (series/movie context).
  playbackJson String?
  /// Last saved position in seconds for this canonical URL.
  positionSeconds Int?
  lastOpenedAt DateTime @default(now())
  openCount    Int      @default(1)

  @@unique([userId, url])
  @@index([userId, lastOpenedAt])
  @@index([userId, openCount])
}

/// Parsed built-in playlist (iptv-org index, etc.) — survives browser clears / new devices.
model PlaylistCatalogCache {
  presetId       String   @id
  channelsJson   String
  channelCount   Int      @default(0)
  updatedAt      DateTime @updatedAt
}

/// User-added streams from Settings — server backup for small manual entry list.
model ManualChannelsStore {
  id          Int      @id @default(1)
  entriesJson String   @default("[]")
  updatedAt   DateTime @updatedAt
}

/// Last Xtream portal used for import — needed for `get_series_info` / VOD detail lookups.
model XtreamPortalConfig {
  id        Int      @id @default(1)
  serverUrl String
  username  String
  password  String
  updatedAt DateTime @updatedAt
}

/// Threadfin sidecar sync status (Plex/Jellyfin HDHomeRun via Threadfin).
model ThreadfinSyncState {
  id             Int       @id @default(1)
  portalUsername String    @default("threadfin")
  lastSyncAt     DateTime?
  lastSyncOk     Boolean   @default(false)
  lastSyncError  String?
  /// JSON: { live, movie, episode, total, capped }
  lastCountsJson String    @default("{}")
  updatedAt      DateTime  @updatedAt
}

/// Wyzie Subs + TMDB keys for VOD subtitle search (Settings → Integrations).
model SubtitleSettings {
  id          Int      @id @default(1)
  wyzieApiKey String?
  tmdbApiKey  String?
  updatedAt   DateTime @updatedAt
}

enum RecordingScheduleStatus {
  SCHEDULED
  CANCELLED
  DISPATCHED
}

enum RecordingStatus {
  RECORDING
  COMPLETED
  FAILED
  STOPPED_EARLY
}

/// Future recording window — picked up by the server scheduler.
model RecordingSchedule {
  id           String                  @id @default(cuid())
  ownerUserId  String
  channelUrl   String
  channelName  String
  channelLogo  String?
  channelGroup String?
  startsAt     DateTime
  endsAt       DateTime
  status       RecordingScheduleStatus @default(SCHEDULED)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  recordings   Recording[]

  @@index([ownerUserId, startsAt])
  @@index([status, startsAt])
}

/// One MP4 capture attempt (manual start or dispatched from a schedule).
model Recording {
  id             String           @id @default(cuid())
  ownerUserId    String
  scheduleId     String?
  schedule       RecordingSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  channelUrl     String
  channelName    String
  channelLogo    String?
  channelGroup   String?
  /// Relative to the recordings root: `<ownerUserId>/<id>.mp4`
  relativePath   String
  status         RecordingStatus
  error          String?
  startedAt      DateTime?
  endedAt        DateTime?
  plannedSeconds Int?
  sizeBytes      BigInt?
  createdAt      DateTime         @default(now())

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@index([ownerUserId, status])
}
