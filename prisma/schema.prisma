generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Auth: optional app login. When enabled, most routes require a valid session.
model AuthConfig {
  id        Int      @id @default(1)
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  USER
}

model User {
  id               String         @id @default(cuid())
  username         String         @unique
  passwordHash     String
  role             UserRole       @default(USER)
  /// The original administrator created at bootstrap — cannot be deleted; password/username can be reset via API or server script.
  isBootstrapAdmin Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  refreshTokens    RefreshToken[]
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Registered stream URLs (synced from clients). Used for nightly/on-demand probes.
model ChannelRegistryEntry {
  urlHash   String   @id
  url       String
  label     String?
  presetId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  probes          HealthProbe[]
  aggregate       HealthAggregate?
  proxyAssignment ChannelProxyAssignment?
}

model HealthProbe {
  id         String   @id @default(cuid())
  urlHash    String
  channel    ChannelRegistryEntry @relation(fields: [urlHash], references: [urlHash], onDelete: Cascade)
  checkedAt  DateTime @default(now())
  ok         Boolean
  latencyMs  Int?
  httpStatus Int?
  error      String?

  @@index([urlHash, checkedAt])
}

model HealthAggregate {
  urlHash     String   @id
  channel     ChannelRegistryEntry @relation(fields: [urlHash], references: [urlHash], onDelete: Cascade)
  tier        String
  successRate Float
  sampleCount Int
  windowDays  Int      @default(7)
  updatedAt   DateTime @updatedAt
}

/// Ephemeral HLS proxy session: maps opaque `id` → upstream URL + rewrite aliases (survives dev HMR).
model StreamProxySession {
  id              String   @id
  upstreamRootUrl String
  title           String
  logo            String?
  groupTitle      String?
  /// JSON object: short hash → absolute upstream URL (for overlong `?u=`).
  urlAliasesJson  String   @default("{}")
  /// JSON: hash → upstream playlist URL that referenced this resource — used as `Referer` for that hash (avoids racing `lastRefererUrl`).
  aliasReferersJson String @default("{}")
  /// JSON: `{ origin: { cookieName: cookieValue } }` — forwarded on segment requests (many CDNs require playlist cookies).
  cookieJarJson   String   @default("{}")
  /// Last upstream playlist URL fetched through this session — segments should use this `Referer` (not only the master URL).
  lastRefererUrl  String?
  /// Serialized StoredProxyConfig — proxy is read once at session creation; the proxy route never needs a second DB query.
  proxyConfigJson String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
}

model ProxyConfig {
  id        String   @id @default(cuid())
  name      String
  /// "direct" | "gluetun"
  vpnType   String   @default("direct")
  protocol  String   @default("http")
  host      String   @default("")
  port      Int      @default(0)
  username  String?
  password  String?
  /// "nordvpn" | "expressvpn" | "protonvpn" | "custom_openvpn" | "custom_wireguard"
  vpnProvider    String?
  /// JSON blob with provider-specific credentials / config
  vpnConfigJson  String?
  /// Docker container ID for the running Gluetun container
  gluetunContainerId String?
  /// Host port mapped to Gluetun's internal HTTP proxy (8888)
  gluetunHostPort    Int?
  /// "stopped" | "starting" | "running" | "error"
  gluetunStatus      String   @default("stopped")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ChannelProxyAssignment[]
}

model ChannelProxyAssignment {
  urlHash   String      @id
  proxyId   String
  proxy     ProxyConfig          @relation(fields: [proxyId], references: [id], onDelete: Cascade)
  channel   ChannelRegistryEntry @relation(fields: [urlHash], references: [urlHash], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([proxyId])
}

/// Parsed built-in playlist (iptv-org index, etc.) — survives browser clears / new devices.
model PlaylistCatalogCache {
  presetId       String   @id
  channelsJson   String
  channelCount   Int      @default(0)
  updatedAt      DateTime @updatedAt
}

/// User-added streams from Settings — server backup for small manual entry list.
model ManualChannelsStore {
  id          Int      @id @default(1)
  entriesJson String   @default("[]")
  updatedAt   DateTime @updatedAt
}
