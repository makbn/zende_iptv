{
  "name": "zende-tv-shells",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "android:build": "node --env-file-if-exists=../.env scripts/android-build.mjs",
    "android:install": "node scripts/android-install.mjs",
    "tizen:configure": "node --env-file-if-exists=../.env scripts/tizen-configure.mjs",
    "tizen:build": "tizen build-web -- tizen && npm run tizen:configure",
    "tizen:package": "node --env-file-if-exists=../.env scripts/tizen-package.mjs"
  }
}
